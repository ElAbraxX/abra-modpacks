{
  "name": "pandarmy-modpacks",
  "main": "worker.mjs",
  "keep_vars": true,
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ]
  },
  "vars": {
    "GITHUB_OWNER": "ElAbraxX",
    "GITHUB_REPO": "Pandarmy-modpacks",
    "ADMIN_LOGIN": "ElAbraxX"
  }
}
